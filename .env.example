# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# Hosted project (default): Supabase dashboard > Connect, or
#   Project Settings > Data API (URL) and Project Settings > API Keys (publishable key).
# Local server: run `npx supabase status` and copy the API URL and publishable key.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: the secret key (Project Settings > API Keys > Secret keys, or
# `npx supabase status` locally). Recording purchases and points needs it.
# It bypasses row-level security, so never give it a NEXT_PUBLIC_ prefix and
# only read it in src/lib/supabase/admin.ts. Add it to Vercel as well.
SUPABASE_SECRET_KEY=
