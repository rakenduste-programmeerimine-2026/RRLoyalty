# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# Hosted project (default): Supabase dashboard > Connect, or
#   Project Settings > Data API (URL) and Project Settings > API Keys (publishable key).
# Local server: run `npx supabase status` and copy the API URL and publishable key.
#
# Only the publishable key belongs here. Never add the secret or service_role key.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
